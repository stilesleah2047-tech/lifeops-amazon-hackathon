NODE_ENV=development
# Local dev port for the BFF. In production (Render) the platform injects PORT
# and the BFF binds that instead; HOST defaults to 0.0.0.0 for the public listener.
BFF_PORT=5174
# PORT=            # set by Render automatically; leave unset locally
# HOST=0.0.0.0     # bind address for the public listener (default 0.0.0.0)
# The MCP server (spec §11 default is 8000).
# Local dev: http://localhost:8000 . On Render: the private service URL,
# e.g. http://lifeops-mcp:8000
MCP_BASE_URL=http://localhost:8000
MCP_PATH=/mcp
# Optional shared secret; must match services/mcp-server/.env if set.
LIFEOPS_API_KEY=
# Default user for demo mode.
DEMO_USER_ID=demo-user

# --- Amazon Bedrock agent (optional; falls back to deterministic engine if unset/unreachable) ---
# Region where your Bedrock model is enabled.
AWS_REGION=us-east-1
# Model ID available in YOUR account/region. Verify in the Bedrock console.
# Example (verify availability): anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MODEL_ID=
# Local dev only. In AWS, prefer IAM roles and leave these empty. Never expose to the browser.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Max Converse tool-use loop iterations (bounded). Default 5.
AGENT_MAX_ITERATIONS=5
# When "true", the agent may execute write tools (create_reminder/complete_task)
# without explicit confirmation. Default false = write tools are only proposed.
AGENT_ALLOW_WRITES=false

# --- Public-API hardening (Phase 3.1) ---
# CORS allowlist (comma-separated). Dev defaults to localhost origins when
# unset; in production set your custom domain and DO NOT use "*".
# ALLOWED_ORIGINS=https://lifeops.example.com
# Shared OPERATOR secret that enables WRITE routes. Unset => writes are DISABLED
# (return 403), which is the safe default. Setting it requires callers to send
# Authorization: Bearer <token>. NOTE: this authenticates the caller, not an
# end user — it is NOT per-user authentication/authorization.
# LIFEOPS_WRITE_TOKEN=
# Per-instance rate limit (optional).
# RATE_LIMIT_MAX=120
# RATE_LIMIT_WINDOW_MS=60000
# Build-time: if you enable writes and want the demo UI's "Mark done" button to
# work, expose the SAME token to the SPA build. WARNING: a VITE_ var is shipped
# to the browser and is visible to end users (casual-abuse gate only).
# VITE_LIFEOPS_WRITE_TOKEN=
